# ResumeX Backend Environment Variables
PORT=5001
NODE_ENV=production

# Frontend Origin for CORS (comma-separated if multiple, e.g. https://your-site.netlify.app)
FRONTEND_URL=http://localhost:5173

# Optional: Google Gemini API Key for semantic resume evaluation
GEMINI_API_KEY=

# Optional: NVIDIA NIM API Key & Model
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/muse-glimmer-30b

# Optional: Adzuna Job Match API (falls back to deterministic catalog)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOB_CACHE_TTL_HOURS=24
